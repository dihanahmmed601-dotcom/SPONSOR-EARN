# Environment Mode
NODE_ENV="production"
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted Cloud Run application endpoint
APP_URL="https://api.earningplatform.com"

# DATABASE: GCP Cloud SQL PostgreSQL Connection
DATABASE_URL="postgres://postgres:securepassword@10.45.0.100:5432/earning_platform?sslmode=require"
PGHOST="10.45.0.100"
PGPORT=5432
PGUSER="postgres"
PGDATABASE="earning_platform"
PGPASSWORD="securepassword"

# AUTHENTICATION & SECURITY
JWT_SECRET="super-secure-production-jwt-signing-secret"
JWT_EXPIRES_IN="7d"

# GCP SECRET MANAGER & CLOUD STORAGE
GCP_PROJECT_ID="sponsor-earning-platform"
GCP_REGION="asia-southeast1"
GCS_BUCKET_NAME="earning-platform-assets"
GCS_KYC_BUCKET_NAME="earning-platform-kyc-docs"

# FIREBASE & FCM NOTIFICATIONS
FIREBASE_PROJECT_ID="sponsor-earning-platform"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@sponsor-earning-platform.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# MOBILE PAYMENT GATEWAYS (bKash / Nagad)
BKASH_APP_KEY="bkash_production_app_key"
BKASH_APP_SECRET="bkash_production_app_secret"
NAGAD_MERCHANT_ID="nagad_merchant_717"
